---
/**
 * Band "Im Einsatz bei" right under the hero: customer names as text marks (no logos, no trademarks reproduced).
 * Texts: home.json "refs_*". An entry without href renders as plain text.
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const refs = t.refs as { name: string; note: string; href: string }[];
---

<section class="ag-refs" aria-label={t.refs_label}>
  <div class="ag-wrap ag-refs__inner" data-reveal>
    <p class="ag-refs__label">{t.refs_label}</p>
    <ul class="ag-refs__list">
      {refs.map((r) => (
        <li>
          {r.href ? (
            <a href={r.href} target="_blank" rel="noopener">
              <strong>{r.name}</strong>
              <small>
                {r.note}
                <Icon name="external" size={13} />
              </small>
            </a>
          ) : (
            <span>
              <strong>{r.name}</strong>
              <small>{r.note}</small>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  .ag-refs {
    position: relative;
    padding-block: 8px 24px;
  }
  .ag-refs__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 40px;
  }
  .ag-refs__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ag-dim);
  }
  .ag-refs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-refs__list a,
  .ag-refs__list span {
    display: grid;
    text-decoration: none;
    text-align: left;
  }
  .ag-refs__list strong {
    font-family: var(--ag-head);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #d9d9e3;
    transition: color var(--ag-fast);
  }
  .ag-refs__list small {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--ag-dim);
  }
  .ag-refs__list a:hover strong {
    color: #fff;
  }
  .ag-refs__list a:hover small {
    color: var(--ag-muted);
  }
  @media (max-width: 560px) {
    .ag-refs__list {
      flex-direction: column;
      align-items: center;
    }
    .ag-refs__list a,
    .ag-refs__list span {
      justify-items: center;
      padding: 6px 12px;
      text-align: center;
    }
    .ag-refs__list small {
      font-size: 0.78rem;
      white-space: nowrap;
    }
  }
</style>
