---
/**
 * Section "rundgang": five steps on the left, a sticky editor mockup on the right that changes with the step in view
 * (desktop: scroll-driven; mobile: the mockup sticks above the steps). Texts: home.json "tour_*".
 *
 * The mockup is built in HTML/CSS (dark mode, Amaze Genius colours) as a stand-in until real dark-mode screenshots
 * or screen recordings exist. To swap in real graphics, replace the `.ag-ed__screen` content of each step with an
 * <img>/<video> per step (keep `data-p` on each) and drop the illustration CSS.
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const steps = t.tour_steps as { key: string; rail: string; title: string; text: string }[];

// Abstract "photos" (sky, sun, two mountain layers) so the mockup needs no stock images.
const photos = [
  { s1: '#ffb36b', s2: '#ff5f8a', m1: '#5b2a86', m2: '#2b1650', sun: '#ffe9a3', sx: '70%', sy: '38%' },
  { s1: '#7fd4ff', s2: '#3d7bff', m1: '#1f4fbf', m2: '#0f2a6e', sun: '#ffffff', sx: '28%', sy: '30%' },
  { s1: '#c3f2a0', s2: '#4fc7a8', m1: '#1d7a62', m2: '#0d3f3a', sun: '#fff7c2', sx: '62%', sy: '34%' },
  { s1: '#ffd36b', s2: '#f3940c', m1: '#b2451a', m2: '#5e1c0c', sun: '#fff3c4', sx: '40%', sy: '42%' },
  { s1: '#e3b8ff', s2: '#9b5cff', m1: '#5a2bb0', m2: '#28125c', sun: '#ffe1fb', sx: '74%', sy: '28%' },
  { s1: '#9ff0ff', s2: '#00c3d9', m1: '#0b6d8c', m2: '#063845', sun: '#ffffff', sx: '22%', sy: '40%' },
];
const ph = (i: number) => {
  const p = photos[i % photos.length];
  return `--s1:${p.s1};--s2:${p.s2};--m1:${p.m1};--m2:${p.m2};--sun:${p.sun};--sx:${p.sx};--sy:${p.sy}`;
};
const rail = [
  { icon: 'photo', label: 'Fotos', step: 0 },
  { icon: 'layout', label: 'Layout', step: 1 },
  { icon: 'background', label: 'Hintergrund', step: 2 },
  { icon: 'clipart', label: 'Cliparts', step: -1 },
  { icon: 'pages', label: 'Buch', step: 4 },
  { icon: 'filter', label: 'Bearbeiten', step: 3 },
] as const;
const swatches = ['#ffffff', '#f6efe6', '#fde2e4', '#dff3ff', '#e9ffe1', '#1c1c25', '#0041F6', '#FF00D8'];
const filters = ['Original', 'Schwarz/Weiß', 'Sepia', 'Invertiert', 'Technicolor', 'Leuchtkraft'];
---

<section class="ag-section ag-tour" id="rundgang">
  <div class="ag-wrap">
    <div class="ag-head">
      <p class="ag-kicker" data-reveal>
        {t.tour_kicker}
      </p>
      <h2 class="ag-h2" data-reveal style="--i:1">
        {t.tour_title_a} <span class="ag-grad">{t.tour_title_b}</span>
      </h2>
      <p class="ag-lead" data-reveal style="--i:2">
        {t.tour_lead}
      </p>
    </div>

    <div class="ag-tour__grid" data-tour>
      <ol class="ag-tour__steps">
        {steps.map((s, i) => (
          <li class="ag-tour__step" data-step={i} aria-current={i === 0 ? 'step' : undefined}>
            <button type="button" class="ag-tour__num" aria-label={`${String(i + 1).padStart(2, '0')} ${s.title}`}>
              {String(i + 1).padStart(2, '0')}
            </button>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ag-tour__stage">
        <div class="ag-tour__fit" data-fit>
          <div class="ag-ed" data-ed data-step="0" aria-hidden="true">
            <div class="ag-ed__top">
              <div class="ag-ed__tools">
                <span>
                  <Icon name="external" size={15} />
                </span>
                <span>
                  <Icon name="save" size={15} />
                </span>
                <span>
                  <Icon name="eye" size={15} />
                </span>
                <i></i>
                <span>
                  <Icon name="undo" size={15} />
                </span>
                <span class="ag-ed__redo">
                  <Icon name="undo" size={15} />
                </span>
              </div>
              <div class="ag-ed__title">
                <strong>{t.tour_mock_product}</strong>
                <small>{t.tour_mock_variant}</small>
              </div>
              <div class="ag-ed__buy">
                <span class="ag-ed__price">{t.tour_mock_price}</span>
                <span class="ag-ed__cart">
                  <Icon name="cart" size={14} />
                  {t.tour_mock_cart}
                  <b class="ag-ed__badge">1</b>
                </span>
              </div>
            </div>

            <div class="ag-ed__body">
              <div class="ag-ed__rail">
                {rail.map((r) => (
                  <span class="ag-ed__railbtn" data-for={r.step}>
                    <Icon name={r.icon} size={17} />
                    <small>{r.label}</small>
                  </span>
                ))}
              </div>

              <div class="ag-ed__panel">
                <div class="ag-ed__pane" data-p="0">
                  <div class="ag-ed__drop">
                    <Icon name="upload" size={18} />
                    {t.tour_mock_upload}
                  </div>
                  <div class="ag-ed__thumbs">
                    {[0, 1, 2, 3, 4, 5, 1, 3, 0].map((p, i) => (
                      <span class="ag-ph" style={`${ph(p)};--d:${i}`} />
                    ))}
                  </div>
                </div>
                <div class="ag-ed__pane" data-p="1">
                  <p class="ag-ed__label">Layouts</p>
                  <div class="ag-ed__layouts">
                    {['l1', 'l2', 'l3', 'l4', 'l5', 'l6'].map((l, i) => (
                      <span class={`ag-ed__lay ${l}`} style={`--d:${i}`}>
                        <i />
                        <i />
                        <i />
                      </span>
                    ))}
                  </div>
                </div>
                <div class="ag-ed__pane" data-p="2">
                  <p class="ag-ed__label">Einfarbig</p>
                  <div class="ag-ed__swatches">
                    {swatches.map((c, i) => (
                      <span style={`background:${c};--d:${i}`} />
                    ))}
                  </div>
                  <p class="ag-ed__label">Aquarell</p>
                  <div class="ag-ed__aqua">
                    <span style="--a:#ffb3c7;--b:#ffe2a8" />
                    <span style="--a:#a8d8ff;--b:#d6b8ff" />
                    <span style="--a:#b8ffd9;--b:#a8f0ff" />
                  </div>
                  <p class="ag-ed__label">Cliparts</p>
                  <div class="ag-ed__cliparts">
                    <Icon name="clipart" size={20} />
                    <Icon name="sparkle" size={20} />
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path
                        d="M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 6c-2.5 4.5-9.5 9-9.5 9z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      ></path>
                    </svg>
                    <Icon name="sun" size={20} />
                  </div>
                </div>
                <div class="ag-ed__pane" data-p="3">
                  <p class="ag-ed__label">Bildauswahl</p>
                  <div class="ag-ed__filters">
                    {filters.map((f, i) => (
                      <span class={`f${i}`} style={`--d:${i}`}>
                        <i class="ag-ph" style={ph(0)} />
                        <small>{f}</small>
                      </span>
                    ))}
                  </div>
                  <div class="ag-ed__slider">
                    <small>Transparenz</small>
                    <i style="--v:.82"></i>
                  </div>
                  <div class="ag-ed__slider">
                    <small>Rahmenstärke</small>
                    <i style="--v:.3"></i>
                  </div>
                </div>
                <div class="ag-ed__pane" data-p="4">
                  <p class="ag-ed__label">Buch-Einstellungen</p>
                  <div class="ag-ed__pages">
                    <span>
                      <small>Seitenzahl</small>
                      <strong>{t.tour_mock_pages}</strong>
                    </span>
                    <b>–</b>
                    <b>+</b>
                  </div>
                  <div class="ag-ed__mini">
                    {[0, 1, 2, 3].map((i) => (
                      <span style={`--d:${i}`}>
                        <i class="ag-ph" style={ph(i + 1)} />
                        <i class="ag-ph" style={ph(i + 2)} />
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <div class="ag-ed__canvas">
                <div class="ag-ed__spread">
                  <div class="ag-ed__page ag-ed__page--l">
                    <span class="ag-ed__blob" />
                    <span class="ag-ed__slot a">
                      <i class="ag-ph" style={ph(1)} />
                    </span>
                    <span class="ag-ed__slot b">
                      <i class="ag-ph" style={ph(2)} />
                    </span>
                    <span class="ag-ed__slot c">
                      <i class="ag-ph" style={ph(3)} />
                    </span>
                  </div>
                  <div class="ag-ed__page ag-ed__page--r">
                    <span class="ag-ed__blob" />
                    <span class="ag-ed__slot d is-sel">
                      <i class="ag-ph" style={ph(0)} />
                      <em class="ag-ed__handles" />
                    </span>
                    <span class="ag-ed__clip">
                      <Icon name="clipart" size={26} />
                    </span>
                    <span class="ag-ed__caption">Sommer 2026</span>
                  </div>
                </div>
                <div class="ag-ed__strip">
                  {[0, 1, 2, 3, 4].map((i) => (
                    <span class={i === 1 ? 'is-on' : ''} />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="ag-tour__dots" aria-hidden="true">
          {steps.map((_, i) => (
            <span data-dot={i} />
          ))}
        </div>
        <p class="ag-tour__note">{t.tour_mock_note}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  const ed = root?.querySelector<HTMLElement>('[data-ed]');
  const fit = root?.querySelector<HTMLElement>('[data-fit]');
  if (root && ed && fit) {
    const steps = [...root.querySelectorAll<HTMLElement>('.ag-tour__step')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const set = (n: number) => {
      ed.dataset.step = String(n);
      for (let k = 1; k <= 4; k++) ed.classList.toggle(`is-s${k}`, n >= k);
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === n);
        s.toggleAttribute('aria-current', i === n);
        if (i === n) s.setAttribute('aria-current', 'step');
      });
      dots.forEach((d, i) => d.classList.toggle('is-on', i === n));
    };
    // The step crossing the activation band becomes active. Desktop: the middle of the viewport.
    // Tablet/mobile: the mockup sticks at the top, so the band sits just below it (otherwise the active text hides).
    const stage = root.querySelector<HTMLElement>('.ag-tour__stage')!;
    let io: IntersectionObserver | null = null;
    const observe = () => {
      io?.disconnect();
      let margin = '-45% 0px -45% 0px';
      if (matchMedia('(max-width: 960px)').matches) {
        const top =
          (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--ag-header-h')) || 76) +
          8 +
          stage.offsetHeight;
        margin = `-${Math.round(top + 16)}px 0px -${Math.max(0, Math.round(innerHeight - top - 140))}px 0px`;
      }
      io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && set(Number((e.target as HTMLElement).dataset.step))),
        { rootMargin: margin },
      );
      steps.forEach((s) => io!.observe(s));
    };
    observe();
    let rt = 0;
    addEventListener('resize', () => {
      clearTimeout(rt);
      rt = window.setTimeout(observe, 200);
    });
    steps.forEach((s) =>
      s.querySelector('button')?.addEventListener('click', () => {
        s.scrollIntoView({ behavior: 'smooth', block: 'center' });
        set(Number(s.dataset.step));
      }),
    );
    set(0);

    // Scale the fixed-size mockup (880×560) to the stage width.
    new ResizeObserver(([e]) => {
      const s = Math.min(1, e.contentRect.width / 880);
      fit.style.setProperty('--s', s.toFixed(4));
      // the stage height changed: move the activation band with it
      clearTimeout(rt);
      rt = window.setTimeout(observe, 60);
    }).observe(fit);
  }
</script>

<style is:global>
  .ag-tour__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) 1.5fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .ag-tour__steps {
    margin: 0;
    padding: 12vh 0 18vh;
    list-style: none;
  }
  .ag-tour__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    min-height: 46vh;
    align-content: center;
  }
  /* inactive steps are dimmed by colour, not opacity, so they keep readable contrast */
  .ag-tour__step h3,
  .ag-tour__step p,
  .ag-tour__num {
    transition: color var(--ag-med) var(--ag-ease);
  }
  .ag-tour__step:not(.is-active) h3,
  .ag-tour__step:not(.is-active) p,
  .ag-tour__step:not(.is-active) .ag-tour__num {
    color: #82829a;
  }
  .ag-tour__num {
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: var(--ag-text);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .ag-tour__num::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    padding: 2px;
    background: conic-gradient(#f81200, #ffe000, #8cff06, #00c3d9, #0041f6, #ff00d8, #f81200);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    rotate: -90deg;
    transition:
      opacity var(--ag-med),
      rotate 1.2s var(--ag-ease);
  }
  .ag-tour__step.is-active .ag-tour__num::before {
    opacity: 1;
    rotate: 0deg;
  }
  .ag-tour__step h3 {
    font-size: var(--ag-h3);
    font-weight: 500;
    margin-top: 6px;
  }
  .ag-tour__step p {
    margin-top: 10px;
    color: var(--ag-muted);
    max-width: 38ch;
  }

  .ag-tour__stage {
    position: sticky;
    top: calc(50vh - 300px + var(--ag-header-h) / 2);
  }
  .ag-tour__fit {
    --s: 1;
    position: relative;
    height: calc(560px * var(--s));
  }
  .ag-tour__fit::before {
    /* coloured glow behind the app window */
    content: '';
    position: absolute;
    inset: 8% 6% -4%;
    background: var(--ag-cool);
    filter: blur(70px);
    opacity: 0.35;
    border-radius: 50%;
  }
  .ag-tour__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }
  .ag-tour__dots span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    transition:
      width var(--ag-med) var(--ag-ease),
      background-color var(--ag-med);
  }
  .ag-tour__dots span.is-on {
    width: 28px;
    background: var(--ag-spectrum);
  }
  .ag-tour__note {
    margin-top: 10px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ag-dim);
  }

  /* ---------- The editor mockup (design size 880×560, scaled by --s) ---------- */
  .ag-ed {
    --acc: var(--ag-blue);
    --acc-l: var(--ag-blue-l);
    position: absolute;
    top: 0;
    left: 0;
    width: 880px;
    height: 560px;
    transform: scale(var(--s));
    transform-origin: 0 0;
    display: grid;
    grid-template-rows: 52px 1fr;
    border-radius: 18px;
    background: #121218;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 40px 100px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
    font-family: var(--ag-font);
    color: #e9e9f0;
    font-size: 12px;
    line-height: 1.3;
  }
  .ag-ed__top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .ag-ed__tools {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #9a9aac;
  }
  .ag-ed__tools span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
  }
  .ag-ed__tools i {
    width: 1px;
    height: 18px;
    margin: 0 4px;
    background: rgba(255, 255, 255, 0.1);
  }
  .ag-ed__redo svg {
    scale: -1 1;
  }
  .ag-ed__title {
    text-align: center;
  }
  .ag-ed__title strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }
  .ag-ed__title small {
    color: #8b8b9e;
    font-size: 11px;
  }
  .ag-ed__buy {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 8px;
  }
  .ag-ed__price {
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    font-weight: 600;
    transition: scale var(--ag-med) var(--ag-spring);
  }
  .ag-ed__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--acc);
    color: #fff;
    font-weight: 600;
    transition:
      box-shadow var(--ag-med),
      background-color var(--ag-med);
  }
  .ag-ed__badge {
    position: absolute;
    top: -6px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ag-magenta);
    font-size: 10px;
    scale: 0;
    transition: scale var(--ag-med) var(--ag-spring);
  }

  .ag-ed__body {
    display: grid;
    grid-template-columns: 70px 220px 1fr;
    min-height: 0;
  }
  .ag-ed__rail {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 12px 8px;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }
  .ag-ed__railbtn {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 8px 0 6px;
    border-radius: 10px;
    color: #8b8b9e;
    transition:
      background-color var(--ag-med),
      color var(--ag-med);
  }
  .ag-ed__railbtn small {
    font-size: 9.5px;
  }
  .ag-ed[data-step='0'] .ag-ed__railbtn[data-for='0'],
  .ag-ed[data-step='1'] .ag-ed__railbtn[data-for='1'],
  .ag-ed[data-step='2'] .ag-ed__railbtn[data-for='2'],
  .ag-ed[data-step='3'] .ag-ed__railbtn[data-for='3'],
  .ag-ed[data-step='4'] .ag-ed__railbtn[data-for='4'] {
    background: color-mix(in srgb, var(--acc) 22%, transparent);
    color: #fff;
  }

  .ag-ed__panel {
    position: relative;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    background: #15151d;
  }
  .ag-ed__pane {
    position: absolute;
    inset: 0;
    padding: 14px;
    opacity: 0;
    visibility: hidden;
    translate: -10px 0;
    transition:
      opacity var(--ag-med) var(--ag-ease),
      translate var(--ag-med) var(--ag-ease),
      visibility 0s linear var(--ag-med);
  }
  .ag-ed[data-step='0'] [data-p='0'],
  .ag-ed[data-step='1'] [data-p='1'],
  .ag-ed[data-step='2'] [data-p='2'],
  .ag-ed[data-step='3'] [data-p='3'],
  .ag-ed[data-step='4'] [data-p='4'] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 0s;
  }
  .ag-ed__label {
    margin: 4px 0 8px;
    font-size: 11px;
    font-weight: 600;
    color: #a9a9bb;
  }
  .ag-ed__label:not(:first-child) {
    margin-top: 14px;
  }
  .ag-ed__drop {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 16px;
    margin-bottom: 12px;
    border-radius: 12px;
    border: 1.5px dashed color-mix(in srgb, var(--acc-l) 60%, transparent);
    color: var(--acc-l);
    font-weight: 600;
  }
  .ag-ed__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .ag-ed__thumbs .ag-ph {
    aspect-ratio: 1;
    border-radius: 6px;
  }
  /* pop-in of the uploaded photos and other pane items when their pane opens */
  .ag-ed__pane > * > * {
    opacity: 0;
    scale: 0.7;
    transition:
      opacity 0.4s var(--ag-ease),
      scale 0.5s var(--ag-spring);
  }
  .ag-ed[data-step='0'] [data-p='0'] > * > *,
  .ag-ed[data-step='1'] [data-p='1'] > * > *,
  .ag-ed[data-step='2'] [data-p='2'] > * > *,
  .ag-ed[data-step='3'] [data-p='3'] > * > *,
  .ag-ed[data-step='4'] [data-p='4'] > * > * {
    opacity: 1;
    scale: 1;
    transition-delay: calc(var(--d, 0) * 70ms + 150ms);
  }
  .ag-ed__layouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ag-ed__lay {
    display: grid;
    gap: 3px;
    padding: 6px;
    aspect-ratio: 1.45;
    border-radius: 8px;
