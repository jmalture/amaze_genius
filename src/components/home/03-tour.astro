---
/**
 * Section "rundgang": five steps on the left, a sticky app window on the right showing the real Amaze Genius
 * dark-mode screens (Figma "AmazeGenius DM" → Fotobuch Desktop → "000 Dark mode", dm Foto branding).
 * Desktop: scroll-driven; tablet/mobile: the window sticks above the steps. On step 4 the window narrows into a
 * tablet for the text-editing screen. Texts: home.json "tour_*". Images: public/media/tour-*.webp.
 * Phones (≤700px) get their own layout instead: a swipeable row of cards, each showing a zoomed-in crop of the
 * screen (z = zoom, fx/fy = top-left corner of the crop as a fraction of the image) above the step text.
 */
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const steps = t.tour_steps as { key: string; title: string; text: string }[];
const alts = t.tour_alt as string[];
const shots = [
  { src: 'tour-1-fotos', w: [1600, 960], h: 857, z: 1.8, fx: 0, fy: 0.05 },
  { src: 'tour-2-seiten', w: [1600, 960], h: 857, z: 1.8, fx: 0.33, fy: 0.15 },
  { src: 'tour-3-bearbeiten', w: [1600, 960], h: 990, z: 1.8, fx: 0, fy: 0.12 },
  { src: 'tour-4-text', w: [1024, 720], h: 746, tablet: true, z: 1.6, fx: 0, fy: 0.08 },
  { src: 'tour-5-vorschau', w: [1600, 960], h: 857, z: 1.8, fx: 0.42, fy: 0.15 },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="ag-section ag-tour" id="rundgang">
  <div class="ag-wrap">
    <div class="ag-head">
      <p class="ag-kicker" data-reveal>
        {t.tour_kicker}
      </p>
      <h2 class="ag-h2" data-reveal style="--i:1">
        {t.tour_title_a} <span class="ag-grad">{t.tour_title_b}</span>
      </h2>
      <p class="ag-lead" data-reveal style="--i:2">
        {t.tour_lead}
      </p>
    </div>

    <div class="ag-tour__grid" data-tour>
      <ol class="ag-tour__steps">
        {steps.map((s, i) => (
          <li class="ag-tour__step" data-step={i} aria-current={i === 0 ? 'step' : undefined}>
            <button type="button" class="ag-tour__num" aria-label={`${String(i + 1).padStart(2, '0')} ${s.title}`}>
              {String(i + 1).padStart(2, '0')}
            </button>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="ag-tour__stage">
        <div class="ag-tour__fit">
          <div class="ag-shot" data-shot data-step="0">
            <div class="ag-shot__bar" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <span class="ag-shot__url">{t.tour_mock_url}</span>
            </div>
            <div class="ag-shot__screen">
              {shots.map((sh, i) => (
                <picture class={`ag-shot__img${sh.tablet ? ' is-tablet' : ''}`} data-i={i}>
                  <source media="(max-width: 700px)" srcset={`/media/${sh.src}-${sh.w[1]}.webp`} />
                  <img
                    src={`/media/${sh.src}-${sh.w[0]}.webp`}
                    alt={alts[i]}
                    width={sh.w[0]}
                    height={sh.h}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ))}
            </div>
          </div>
        </div>
        <div class="ag-tour__dots" aria-hidden="true">
          {steps.map((_, i) => (
            <span data-dot={i} />
          ))}
        </div>
        <p class="ag-tour__note">{t.tour_mock_note}</p>
      </div>
    </div>

    <div class="ag-tourm" data-tourm>
      <ol class="ag-tourm__track" tabindex="0" aria-label={t.tour_kicker}>
        {steps.map((s, i) => (
          <li class="ag-tourm__slide" data-slide={i} aria-label={`${pad(i)} / ${pad(steps.length - 1)}`}>
            <div
              class={`ag-tourm__shot${shots[i].tablet ? ' is-tablet' : ''}`}
              style={`--z:${shots[i].z};--fx:${shots[i].fx * -100}%;--fy:${shots[i].fy * -100}%`}
            >
              <img
                src={`/media/${shots[i].src}-${shots[i].w[1]}.webp`}
                srcset={`/media/${shots[i].src}-${shots[i].w[1]}.webp ${shots[i].w[1]}w, /media/${shots[i].src}-${shots[i].w[0]}.webp ${shots[i].w[0]}w`}
                sizes={`${Math.round(shots[i].z * 84)}vw`}
                alt={alts[i]}
                width={shots[i].w[0]}
                height={shots[i].h}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="ag-tourm__body">
              <span class="ag-tourm__num">{pad(i)}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="ag-tourm__dots">
        {steps.map((s, i) => (
          <button
            type="button"
            data-go={i}
            aria-label={`${pad(i)} ${s.title}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span />
          </button>
        ))}
      </div>
      <p class="ag-tour__note ag-tourm__note">{t.tour_mock_note}</p>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  const shot = root?.querySelector<HTMLElement>('[data-shot]');
  if (root && shot) {
    const steps = [...root.querySelectorAll<HTMLElement>('.ag-tour__step')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const set = (n: number) => {
      shot.dataset.step = String(n);
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === n);
        s.toggleAttribute('aria-current', i === n);
        if (i === n) s.setAttribute('aria-current', 'step');
      });
      dots.forEach((d, i) => d.classList.toggle('is-on', i === n));
    };
    // The step crossing the activation band becomes active. Desktop: the middle of the viewport.
    // Tablet/mobile: the window sticks at the top, so the band sits just below it (otherwise the active text hides).
    const stage = root.querySelector<HTMLElement>('.ag-tour__stage')!;
    let io: IntersectionObserver | null = null;
    const observe = () => {
      io?.disconnect();
      let margin = '-45% 0px -45% 0px';
      if (matchMedia('(max-width: 960px)').matches) {
        const top =
          (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--ag-header-h')) || 76) +
          8 +
          stage.offsetHeight;
        margin = `-${Math.round(top + 16)}px 0px -${Math.max(0, Math.round(innerHeight - top - 140))}px 0px`;
      }
      io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && set(Number((e.target as HTMLElement).dataset.step))),
        { rootMargin: margin },
      );
      steps.forEach((s) => io!.observe(s));
    };
    observe();
    let rt = 0;
    new ResizeObserver(() => {
      clearTimeout(rt);
      rt = window.setTimeout(observe, 120);
    }).observe(stage);
    steps.forEach((s) =>
      s.querySelector('button')?.addEventListener('click', () => {
        s.scrollIntoView({ behavior: 'smooth', block: 'center' });
        set(Number(s.dataset.step));
      }),
    );
    // Images are lazy: start loading all five once the section is near, so step changes never show a blank.
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting) return;
        obs.disconnect();
        if (shot.offsetParent) shot.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      },
      { rootMargin: '600px' },
    ).observe(shot);
    set(0);
  }

  // Phones: swipeable cards. The dots follow the card in view and jump to a card on tap.
  const m = document.querySelector<HTMLElement>('[data-tourm]');
  const track = m?.querySelector<HTMLElement>('.ag-tourm__track');
  if (m && track) {
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...m.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const on = (n: number) => dots.forEach((d, i) => d.toggleAttribute('aria-current', i === n));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && on(Number((e.target as HTMLElement).dataset.slide))),
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        const s = slides[i];
        track.scrollTo({ left: s.offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
      }),
    );
    // once the first card is near, load the rest so swiping never shows a blank
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting || !m.offsetParent) return;
        obs.disconnect();
        track.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      },
      { rootMargin: '400px' },
    ).observe(m);
  }
</script>

<style is:global>
  .ag-tour__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) 1.5fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .ag-tour__steps {
    margin: 0;
    padding: 12vh 0 18vh;
    list-style: none;
  }
  .ag-tour__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    min-height: 46vh;
    align-content: center;
  }
  /* inactive steps are dimmed by colour, not opacity, so they keep readable contrast */
  .ag-tour__step h3,
  .ag-tour__step p,
  .ag-tour__num {
    transition: color var(--ag-med) var(--ag-ease);
  }
  .ag-tour__step:not(.is-active) h3,
  .ag-tour__step:not(.is-active) p,
  .ag-tour__step:not(.is-active) .ag-tour__num {
    color: #82829a;
  }
  .ag-tour__num {
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: var(--ag-text);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  .ag-tour__num::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    padding: 2px;
    background: conic-gradient(#f81200, #ffe000, #8cff06, #00c3d9, #0041f6, #ff00d8, #f81200);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    rotate: -90deg;
    transition:
      opacity var(--ag-med),
      rotate 1.2s var(--ag-ease);
  }
  .ag-tour__step.is-active .ag-tour__num::before {
    opacity: 1;
    rotate: 0deg;
  }
  .ag-tour__step h3 {
    font-size: var(--ag-h3);
    font-weight: 500;
    margin-top: 6px;
  }
  .ag-tour__step p {
    margin-top: 10px;
    color: var(--ag-muted);
    max-width: 38ch;
  }

  .ag-tour__stage {
    position: sticky;
    top: calc(50vh - 300px + var(--ag-header-h) / 2);
  }
  .ag-tour__fit {
    position: relative;
    aspect-ratio: 1920 / 1068;
  }
  .ag-tour__fit::before {
    /* coloured glow behind the app window */
    content: '';
    position: absolute;
    inset: 8% 6% -4%;
    background: var(--ag-cool);
    filter: blur(70px);
    opacity: 0.35;
    border-radius: 50%;
  }
  .ag-tour__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }
  .ag-tour__dots span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    transition:
      width var(--ag-med) var(--ag-ease),
      background-color var(--ag-med);
  }
  .ag-tour__dots span.is-on {
    width: 28px;
    background: var(--ag-spectrum);
  }
  .ag-tour__note {
    margin-top: 10px;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ag-dim);
  }

  /* ---------- App window with the real screens ---------- */
  .ag-shot {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 100%;
    translate: -50% 0;
    display: grid;
    grid-template-rows: 40px 1fr;
    border-radius: 16px;
    background: #262626;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 40px 100px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
    transition:
      width 0.9s var(--ag-ease-io),
      border-radius 0.9s var(--ag-ease-io);
  }
  /* step 4: the window becomes a tablet */
  .ag-shot[data-step='3'] {
    width: 74%;
    border-radius: 28px;
  }
  .ag-shot__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    background: #141414;
  }
  .ag-shot__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a3a3a;
  }
  .ag-shot__bar i:nth-child(1) {
    background: #ff5f57;
  }
  .ag-shot__bar i:nth-child(2) {
    background: #febc2e;
  }
  .ag-shot__bar i:nth-child(3) {
    background: #28c840;
  }
  .ag-shot__url {
    margin-left: auto;
    margin-right: auto;
    padding: 4px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
    font-size: 11px;
    color: #a8a8b4;
    translate: -20px 0;
  }
  .ag-shot__screen {
    position: relative;
    overflow: hidden;
    background: #262626;
  }
  .ag-shot__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    scale: 1.03;
    transition:
      opacity 0.6s var(--ag-ease),
      scale 0.9s var(--ag-ease);
  }
  .ag-shot__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .ag-shot__img.is-tablet img {
    object-fit: cover;
    object-position: center;
  }
  .ag-shot[data-step='0'] [data-i='0'],
  .ag-shot[data-step='1'] [data-i='1'],
  .ag-shot[data-step='2'] [data-i='2'],
  .ag-shot[data-step='3'] [data-i='3'],
  .ag-shot[data-step='4'] [data-i='4'] {
    opacity: 1;
    scale: 1;
  }

  /* ---------- Phones: swipeable cards ---------- */
  .ag-tourm {
    display: none;
  }
  @media (max-width: 700px) {
    .ag-tour__grid {
      display: none;
    }
    .ag-tourm {
      display: block;
      margin-top: 32px;
    }
    .ag-tourm__track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      gap: 12px;
      margin: 0 calc(-1 * var(--ag-gutter));
      padding: 4px var(--ag-gutter) 8px;
      scroll-padding-inline: var(--ag-gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      list-style: none;
    }
    .ag-tourm__track::-webkit-scrollbar {
      display: none;
    }
    .ag-tourm__track:focus-visible {
      outline: 2px solid var(--ag-blue-l);
      outline-offset: -2px;
    }
    .ag-tourm__slide {
      display: grid;
      grid-template-rows: auto 1fr;
      scroll-snap-align: start;
      border-radius: var(--ag-r-lg);
      background: var(--ag-surface);
      border: 1px solid var(--ag-line);
      overflow: hidden;
    }
    .ag-tourm__shot {
      position: relative;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #262626;
      border-bottom: 1px solid var(--ag-line);
    }
    .ag-tourm__shot img {
      position: absolute;
      top: 0;
      left: 0;
      width: calc(var(--z) * 100%);
      max-width: none;
      height: auto;
      translate: var(--fx) var(--fy);
    }
    .ag-tourm__body {
      padding: 18px 18px 22px;
    }
    .ag-tourm__num {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--ag-muted);
    }
    .ag-tourm__body h3 {
      margin-top: 12px;
      font-size: 1.25rem;
      font-weight: 500;
    }
    .ag-tourm__body p {
      margin-top: 8px;
      color: var(--ag-muted);
      font-size: 0.9375rem;
    }
    .ag-tourm__dots {
      display: flex;
      justify-content: center;
      margin-top: 10px;
    }
    .ag-tourm__dots button {
      display: grid;
      place-items: center;
      width: 36px;
      height: 44px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .ag-tourm__dots span {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.18);
      transition:
        width var(--ag-med) var(--ag-ease),
        background-color var(--ag-med);
    }
    .ag-tourm__dots [aria-current] span {
      width: 28px;
      background: var(--ag-spectrum);
    }
    .ag-tourm .ag-tourm__note {
      display: block;
      margin-top: 2px;
    }
    .ag-shot {
      grid-template-rows: 24px 1fr;
      border-radius: 10px;
    }
    .ag-shot[data-step='3'] {
      border-radius: 16px;
    }
    .ag-shot__bar {
      gap: 5px;
      padding: 0 9px;
    }
    .ag-shot__bar i {
      width: 7px;
      height: 7px;
    }
    .ag-shot__url {
      padding: 2px 10px;
      font-size: 9px;
      border-radius: 6px;
    }
  }
  @media (max-width: 960px) {
    .ag-tour__grid {
      grid-template-columns: 1fr;
    }
    .ag-tour__stage {
      grid-row: 1;
      position: sticky;
      top: calc(var(--ag-header-h) + 8px);
      z-index: 2;
      padding: 12px 0 16px;
      background: linear-gradient(180deg, var(--ag-bg) 85%, transparent);
    }
    /* covers the strip above the stage when the header slides away */
    .ag-tour__stage::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: calc(var(--ag-header-h) + 8px);
      background: var(--ag-bg);
    }
    .ag-tour__note {
      display: none;
    }
    .ag-tour__dots {
      margin-top: 14px;
    }
    .ag-tour__steps {
      padding: 4vh 0 10vh;
    }
    .ag-tour__step {
      min-height: 42vh;
      align-content: start;
      padding-top: 6vh;
    }
  }
</style>
