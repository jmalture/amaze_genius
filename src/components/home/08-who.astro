---
/**
 * Section "fuer-wen": audience tiles (Hersteller, Händler, B2C, B2B) and the "Gebaut von Jenomics" band.
 * Texts: home.json "who_*" and "jx_*". Years since 2001 are computed ({years}).
 */
import Icon from '../ui/Icon.astro';
import { pick, fill, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const items = t.who_items as { icon: 'factory' | 'shop' | 'users' | 'building'; title: string; text: string }[];
const stats = t.jx_stats as { value: string; label: string }[];
---

<section class="ag-section ag-who" id="fuer-wen">
  <div class="ag-wrap">
    <div class="ag-head">
      <p class="ag-kicker" data-reveal>
        {t.who_kicker}
      </p>
      <h2 class="ag-h2" data-reveal style="--i:1">
        {t.who_title_a}
        <br />
        <span class="ag-grad">{t.who_title_b}</span>
      </h2>
      <p class="ag-lead" data-reveal style="--i:2">
        {t.who_lead}
      </p>
    </div>

    <ul class="ag-who__grid" data-spotlight>
      {items.map((it, i) => (
        <li class="ag-card" data-reveal style={`--i:${i}`}>
          <span class="ag-who__ico">
            <Icon name={it.icon} size={26} />
          </span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>

    <div class="ag-jx" data-reveal>
      <div class="ag-jx__copy">
        <p class="ag-kicker">{t.jx_kicker}</p>
        <h3>{fill(t.jx_title)}</h3>
        <p>{fill(t.jx_text)}</p>
        <a class="ag-jx__link" href="https://www.jenomics.de/" target="_blank" rel="noopener">
          {t.jx_link}
          <Icon name="external" size={16} />
        </a>
      </div>
      <dl class="ag-jx__stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{fill(s.value)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style is:global>
  .ag-who__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-who__grid li {
    padding: 28px 24px;
    transition: translate var(--ag-med) var(--ag-ease);
  }
  .ag-who__grid li:hover {
    translate: 0 -5px;
  }
  .ag-who__ico {
    display: inline-grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--ag-orchid-l);
    transition:
      background var(--ag-med),
      color var(--ag-med),
      rotate var(--ag-med) var(--ag-spring);
  }
  .ag-who__grid li:hover .ag-who__ico {
    background: var(--ag-cool);
    color: #fff;
    rotate: -8deg;
  }
  .ag-who__grid h3 {
    margin-top: 22px;
    font-size: 1.375rem;
    font-weight: 500;
  }
  .ag-who__grid p {
    margin-top: 8px;
    color: var(--ag-muted);
    font-size: 0.9375rem;
  }

  .ag-jx {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    margin-top: clamp(48px, 6vw, 88px);
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--ag-r-xl);
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(0, 65, 246, 0.28), transparent 60%),
      radial-gradient(60% 100% at 0% 100%, rgba(255, 0, 216, 0.16), transparent 60%), var(--ag-surface);
    border: 1px solid var(--ag-line);
    overflow: hidden;
  }
  .ag-jx::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--ag-spectrum);
  }
  .ag-jx__copy h3 {
    margin-top: 14px;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 500;
  }
  .ag-jx__copy > p:not(.ag-kicker) {
    margin-top: 14px;
    color: var(--ag-muted);
  }
  .ag-jx__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-weight: 600;
    color: var(--ag-blue-l);
    text-decoration: none;
  }
  .ag-jx__link:hover {
    color: #fff;
  }
  .ag-jx__stats {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .ag-jx__stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: 16px 20px;
    border-radius: var(--ag-r);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--ag-line);
  }
  .ag-jx__stats dd {
    margin: 0;
    font-family: var(--ag-head);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .ag-jx__stats dt {
    font-size: 0.875rem;
    color: var(--ag-muted);
  }

  @media (max-width: 1000px) {
    .ag-who__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ag-jx {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .ag-who__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
