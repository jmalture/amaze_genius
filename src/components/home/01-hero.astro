---
/**
 * Section "hero": the WebGL ribbons (src/scripts/ribbons.ts) behind the logo icon, headline and CTAs.
 * Texts: src/i18n/home.json, keys "hero_*". Without WebGL (or with reduced motion) a CSS spectrum glow
 * stands in, reduced motion gets one still frame of the ribbons.
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
---

<section class="ag-hero" id="start" data-hero>
  <canvas class="ag-hero__gl" aria-hidden="true" data-ribbons="hero"></canvas>
  <div class="ag-hero__veil" aria-hidden="true"></div>

  <div class="ag-wrap ag-hero__inner">
    <div class="ag-hero__mark" aria-hidden="true">
      <img src="/media/ag-icon.webp" alt="" width="160" height="160" fetchpriority="high" />
    </div>
    <p class="ag-hero__badge">
      <span class="ag-hero__dot" aria-hidden="true"></span>
      {t.hero_badge}
    </p>
    <h1 class="ag-hero__title" aria-label={`${t.hero_title_a} ${t.hero_title_b}`}>
      <span class="ag-hero__line" aria-hidden="true">
        <span style="--i:1">{t.hero_title_a}</span>
      </span>
      <span class="ag-hero__line" aria-hidden="true">
        <span class="ag-grad-s" style="--i:2">
          {t.hero_title_b}
        </span>
      </span>
    </h1>
    <p class="ag-hero__lead">{t.hero_lead}</p>
    <div class="ag-hero__ctas">
      <a class="ag-btn" href="#kontakt">
        {t.hero_cta}
        <Icon name="arrow" size={18} />
      </a>
      <a class="ag-btn ag-btn--ghost" href="#rundgang">
        {t.hero_cta2}
      </a>
    </div>
    <ul class="ag-hero__facts">
      {(t.hero_facts as string[]).map((f, i) => (
        <li style={`--i:${i}`}>
          <Icon name="check" size={16} />
          {f}
        </li>
      ))}
    </ul>
  </div>

  <a class="ag-hero__scroll" href="#sortiment" aria-label={t.hero_scroll}>
    <span></span>
  </a>
</section>

<script>
  import { createRibbons } from '../../scripts/ribbons';
  import { HERO_POSES } from '../../scripts/ribbon-poses';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-ribbons="hero"]');
  const section = document.querySelector<HTMLElement>('[data-hero]');
  if (canvas && section) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const q = new URLSearchParams(location.search).get('pose');
    // One big ribbon morphing through the 2023 motifs, plus a faint mirrored echo for depth.
    const ctl = createRibbons(canvas, {
      still,
      pose: q != null ? Number(q) : undefined,
      sparkles: 9,
      alpha: 0.62,
      duration: 12,
      motion: 0.6,
      ribbons: [
        { poses: HERO_POSES, lines: 92, fan: 0.3 },
        { poses: HERO_POSES, offset: 3, flipX: true, flipY: true, gain: 0.24, lines: 56, width: 0.75, fan: 0.2 },
      ],
    });
    section.classList.add(ctl ? 'has-gl' : 'no-gl');
  }
</script>

<style is:global>
  .ag-hero {
    position: relative;
    isolation: isolate;
    min-height: max(680px, 100svh);
    display: grid;
    align-items: center;
    padding-block: calc(var(--ag-header-h) + 40px) 96px;
    overflow: hidden;
    background: radial-gradient(60% 50% at 50% 0%, rgba(0, 65, 246, 0.16), transparent 70%), var(--ag-bg);
  }
  .ag-hero__gl {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ag-ease);
  }
  .ag-hero.has-gl .ag-hero__gl {
    opacity: 1;
  }
  /* Fallback without WebGL: soft spectrum glows */
  .ag-hero.no-gl::before,
  .no-js .ag-hero::before {
    content: '';
    position: absolute;
    inset: 10% -20%;
    z-index: -2;
    background:
      radial-gradient(40% 30% at 20% 60%, rgba(248, 18, 0, 0.35), transparent 70%),
      radial-gradient(35% 30% at 45% 45%, rgba(255, 224, 0, 0.22), transparent 70%),
      radial-gradient(40% 35% at 75% 40%, rgba(0, 65, 246, 0.4), transparent 70%),
      radial-gradient(30% 30% at 85% 70%, rgba(255, 0, 216, 0.3), transparent 70%);
    filter: blur(30px);
  }
  /* Keeps the text readable over the brightest crossings */
  .ag-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 38% at 50% 52%, rgba(9, 9, 12, 0.72), rgba(9, 9, 12, 0.25) 70%, transparent 100%),
      linear-gradient(180deg, transparent 70%, var(--ag-bg) 100%);
    pointer-events: none;
  }

  .ag-hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .ag-hero__mark {
    position: relative;
    width: clamp(64px, 7vw, 92px);
    margin-bottom: 26px;
  }
  .ag-hero__mark::before {
    content: '';
    position: absolute;
    inset: -40%;
    border-radius: 50%;
    background: conic-gradient(from 200deg, #f81200, #ffe000, #8cff06, #00c3d9, #0041f6, #ff00d8, #f81200);
    filter: blur(28px);
    opacity: 0.45;
    animation: ag-spin 14s linear infinite;
  }
  .ag-hero__mark img {
    position: relative;
    width: 100%;
    height: auto;
    animation: ag-mark-in 1.2s var(--ag-spring) both 0.1s;
  }
  @keyframes ag-mark-in {
    from {
      opacity: 0;
      scale: 0.4;
      rotate: -90deg;
    }
  }
  @keyframes ag-spin {
    to {
      rotate: 360deg;
    }
  }
  .ag-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 16px 7px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--ag-line-2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ag-text);
    animation: ag-fade-up 0.9s var(--ag-ease) both 0.3s;
  }
  .ag-hero__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ag-magenta);
    box-shadow: 0 0 12px var(--ag-magenta);
  }
  .ag-hero__dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--ag-magenta);
    animation: ag-ping 2.4s var(--ag-ease) infinite;
  }
  @keyframes ag-ping {
    0% {
      opacity: 0.8;
      scale: 0.6;
    }
    80%,
    100% {
      opacity: 0;
      scale: 1.9;
    }
  }
  .ag-hero__title {
    margin: 26px 0 26px;
    font-size: var(--ag-h1);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .ag-hero__line {
    display: block;
    overflow: clip;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .ag-hero__line > span {
    display: inline-block;
  }
  .js .ag-hero__line > span {
    translate: 0 108%;
    animation: ag-rise 1.15s var(--ag-ease) forwards;
    animation-delay: calc(var(--i) * 120ms + 250ms);
  }
  .js .ag-hero__line > .ag-grad-s {
    animation:
      ag-rise 1.15s var(--ag-ease) forwards calc(var(--i) * 120ms + 250ms),
      ag-flow 10s ease-in-out infinite alternate 1.6s;
  }
  @keyframes ag-rise {
    to {
      translate: 0 0;
    }
  }
  @keyframes ag-fade-up {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }
  .ag-hero__lead {
    max-width: 640px;
    font-size: var(--ag-lead);
    color: #d4d4de;
    animation: ag-fade-up 1s var(--ag-ease) both 0.7s;
  }
  .ag-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
    animation: ag-fade-up 1s var(--ag-ease) both 0.85s;
  }
  .ag-hero__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 26px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: var(--ag-muted);
  }
  .ag-hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    animation: ag-fade-up 0.9s var(--ag-ease) both;
    animation-delay: calc(var(--i) * 90ms + 1s);
  }
  .ag-hero__facts svg {
    color: var(--ag-magenta-l);
  }

  .ag-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border-radius: 14px;
    border: 2px solid rgba(255, 255, 255, 0.22);
  }
  .ag-hero__scroll span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
    animation: ag-wheel 2s var(--ag-ease) infinite;
  }
  @keyframes ag-wheel {
    0% {
      opacity: 0;
      translate: 0 -4px;
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 12px;
    }
  }
  @media (max-height: 760px), (max-width: 700px) {
    .ag-hero__scroll {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .ag-hero__ctas {
      width: 100%;
      flex-direction: column;
    }
    .ag-hero__facts {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
