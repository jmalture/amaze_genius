---
/**
 * Section "ablauf": four steps on a spectrum line. When the list comes into view it plays once, from 1 to 4: the line
 * grows from node to node and each node lights up (with its title and text) the moment the line reaches it.
 * The line is measured from node centre to node centre in JS, so it works for the row (desktop) and the column
 * (≤860px). Without JS or with reduced motion everything is shown at once. Texts: home.json "flow_*".
 */
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const steps = t.flow_steps as { title: string; text: string }[];
---

<section class="ag-section ag-flow" id="ablauf">
  <div class="ag-wrap">
    <div class="ag-head">
      <p class="ag-kicker" data-reveal>
        {t.flow_kicker}
      </p>
      <h2 class="ag-h2" data-reveal style="--i:1">
        {t.flow_title_a} <span class="ag-grad">{t.flow_title_b}</span>
      </h2>
      <p class="ag-lead" data-reveal style="--i:2">
        {t.flow_lead}
      </p>
    </div>

    <ol class="ag-flow__list" data-flow>
      <li class="ag-flow__line" aria-hidden="true">
        <span></span>
      </li>
      {steps.map((s, i) => (
        <li class="ag-flow__step" style={`--i:${i}`}>
          <span class="ag-flow__node">
            <b>{i + 1}</b>
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>('[data-flow]');
  if (list && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const line = list.querySelector<HTMLElement>('.ag-flow__line')!;
    const fill = line.querySelector<HTMLElement>('span')!;
    const nodes = [...list.querySelectorAll<HTMLElement>('.ag-flow__node')];
    const STEP = 1100; // ms from one node to the next, matches --step in the CSS
    let fractions = [0, 1 / 3, 2 / 3, 1];
    let vertical = false;
    // Line from the centre of node 1 to the centre of node 4; fractions = where the other nodes sit on it.
    const layout = () => {
      const lr = list.getBoundingClientRect();
      const c = nodes.map((n) => {
        const r = n.getBoundingClientRect();
        return [r.left + r.width / 2 - lr.left, r.top + r.height / 2 - lr.top];
      });
      vertical = Math.abs(c[3][1] - c[0][1]) > Math.abs(c[3][0] - c[0][0]);
      const len = vertical ? c[3][1] - c[0][1] : c[3][0] - c[0][0];
      Object.assign(line.style, {
        left: `${vertical ? c[0][0] - 1 : c[0][0]}px`,
        top: `${vertical ? c[0][1] : c[0][1] - 1}px`,
        right: 'auto',
        bottom: 'auto',
        width: vertical ? '2px' : `${len}px`,
        height: vertical ? `${len}px` : '2px',
      });
      fractions = c.map((p) => (vertical ? p[1] - c[0][1] : p[0] - c[0][0]) / len);
    };
    layout();
    new ResizeObserver(layout).observe(list);
    list.classList.add('is-armed');
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting) return;
        obs.disconnect();
        layout();
        // clip instead of scale, so the spectrum stays in place and is uncovered colour by colour
        const cut = (f: number) => `${((1 - f) * 100).toFixed(2)}%`;
        const s = (f: number) => (vertical ? `inset(0 0 ${cut(f)} 0)` : `inset(0 ${cut(f)} 0 0)`);
        fill.animate(
          fractions.map((f, i) => ({ clipPath: s(f), offset: i / 3, easing: 'cubic-bezier(0.55, 0, 0.35, 1)' })),
          { duration: STEP * 3, delay: 400, fill: 'both' },
        );
        list.classList.add('is-play');
      },
      { threshold: 0.45 },
    ).observe(list);
  }
</script>

<style is:global>
  .ag-flow__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ag-flow__line {
    position: absolute;
    left: 28px;
    right: 0;
    top: 27px;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }
  .ag-flow__line span {
    position: absolute;
    inset: 0;
    background: var(--ag-spectrum);
  }
  .is-armed .ag-flow__line span {
    clip-path: inset(0 100% 0 0);
  }
  .ag-flow__step {
    position: relative;
    /* when this step lights up: node 1 as the line starts, then one node every --step */
    --d: calc(0.4s + var(--i) * 1.1s);
  }

  /* ---------- the 1 → 4 sequence (only once JS has armed it) ---------- */
  .is-armed .ag-flow__node::before {
    opacity: 0;
    scale: 0.35;
  }
  .is-armed .ag-flow__node b {
    color: var(--ag-dim);
  }
  .is-armed .ag-flow__step h3,
  .is-armed .ag-flow__step p {
    opacity: 0;
    translate: 0 12px;
  }
  .is-armed.is-play .ag-flow__node::before {
    opacity: 0.9;
    scale: 1;
    transition:
      opacity 0.45s var(--ag-ease) var(--d),
      scale 0.8s var(--ag-spring) var(--d);
  }
  .is-armed.is-play .ag-flow__node b {
    color: var(--ag-text);
    transition: color 0.4s var(--d);
  }
  .is-armed.is-play .ag-flow__node::after {
    /* one ring that pings outwards as the node lights up */
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    opacity: 0;
    animation: ag-ping 1s var(--ag-ease) var(--d) both;
  }
  @keyframes ag-ping {
    0% {
      opacity: 0.9;
      scale: 0.9;
    }
    100% {
      opacity: 0;
      scale: 1.7;
    }
  }
  .is-armed.is-play .ag-flow__step h3,
  .is-armed.is-play .ag-flow__step p {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 0.6s var(--ag-ease) calc(var(--d) + 0.1s),
      translate 0.7s var(--ag-ease) calc(var(--d) + 0.1s);
  }
  .is-armed.is-play .ag-flow__step p {
    transition-delay: calc(var(--d) + 0.22s);
  }
  .ag-flow__node {
    position: relative;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ag-bg);
    border: 1px solid var(--ag-line-2);
  }
  .ag-flow__node::before {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: var(--ag-cool);
    opacity: 0.9;
  }
  .ag-flow__node b {
    position: relative;
    font-family: var(--ag-head);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .ag-flow__step:nth-child(3) .ag-flow__node::before {
    background: linear-gradient(135deg, #00c3d9, #0041f6);
  }
  .ag-flow__step:nth-child(4) .ag-flow__node::before {
    background: linear-gradient(135deg, #8cff06, #00c3d9);
  }
  .ag-flow__step:nth-child(5) .ag-flow__node::before {
    background: linear-gradient(135deg, #ffe000, #f81200);
  }
  .ag-flow__step h3 {
    margin-top: 22px;
    font-size: var(--ag-h3);
    font-weight: 500;
  }
  .ag-flow__step p {
    margin-top: 8px;
    color: var(--ag-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .ag-flow__list {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .ag-flow__line {
      left: 27px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
    }
    .ag-flow__line span {
      background: linear-gradient(
        180deg,
        var(--ag-red),
        var(--ag-orange),
        var(--ag-yellow),
        var(--ag-lime),
        var(--ag-cyan),
        var(--ag-blue),
        var(--ag-orchid),
        var(--ag-magenta)
      );
    }
    .is-armed .ag-flow__line span {
      clip-path: inset(0 0 100% 0);
    }
    .ag-flow__step {
      display: grid;
      grid-template-columns: 56px 1fr;
      column-gap: 20px;
    }
    .ag-flow__node {
      grid-row: span 2;
    }
    .ag-flow__step h3 {
      margin-top: 12px;
    }
  }
</style>
