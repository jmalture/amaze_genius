---
/**
 * Section "mobil": a phone with the editor next to a laptop; the saved project travels along a spectrum arc from
 * phone to laptop (save in the customer account, continue on another device). Texts: home.json "mobile_*".
 */
import Icon from '../ui/Icon.astro';
import { pick, type Lang } from '../../i18n';
import data from '../../i18n/home.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(data as Record<string, any>, lang);
const points = t.mobile_points as { icon: 'phone' | 'save' | 'sync'; title: string; text: string }[];
---

<section class="ag-section ag-mob" id="mobil">
  <div class="ag-wrap ag-mob__grid">
    <div class="ag-mob__stage" data-reveal="scale" data-play>
      <div class="ag-mob__laptop" aria-hidden="true">
        <div class="ag-mob__lscreen">
          <div class="ag-mob__lbar">
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="ag-mob__lbody">
            <span class="ag-mob__lrail"></span>
            <span class="ag-mob__lpanel"></span>
            <span class="ag-mob__lpage">
              <b class="ag-mob__lphoto"></b>
              <b class="ag-mob__lgrid"></b>
            </span>
          </div>
          <span class="ag-mob__toast">
            <Icon name="check" size={13} />
            {t.mobile_sync}
          </span>
        </div>
        <div class="ag-mob__base"></div>
      </div>

      <div class="ag-mob__path" aria-hidden="true">
        <svg class="ag-mob__arc" viewBox="0 0 600 420" width="600" height="420">
          <defs>
            <linearGradient id="ag-arc" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#FF00D8" />
              <stop offset=".5" stop-color="#7029BC" />
              <stop offset="1" stop-color="#00C3D9" />
            </linearGradient>
          </defs>
          <path
            d="M232 214 C 290 110, 380 70, 440 140"
            fill="none"
            stroke="url(#ag-arc)"
            stroke-width="2"
            stroke-dasharray="6 8"
          />
        </svg>
        <span class="ag-mob__card">
          <i></i>
          <span>
            <b>{t.mobile_mock_title}</b>
            <small>12 Seiten</small>
          </span>
        </span>
      </div>

      <div class="ag-mob__phone" aria-hidden="true">
        <div class="ag-mob__screen">
          <div class="ag-mob__pbar">
            <span>‹</span>
            <b>{t.mobile_mock_title}</b>
            <span class="ag-mob__pcart">
              <Icon name="cart" size={13} />
            </span>
          </div>
          <div class="ag-mob__pcanvas">
            <div class="ag-mob__ppage">
              <div class="ag-mob__pphoto">
                <i></i>
                <i></i>
                <i></i>
              </div>
              <strong>{t.mobile_mock_month}</strong>
              <div class="ag-mob__pdays">
                {Array.from({ length: 28 }, (_, i) => (
                  <span class={i === 9 ? 'is-on' : ''} />
                ))}
              </div>
            </div>
          </div>
          <div class="ag-mob__ptools">
            <span class="is-on">
              <Icon name="photo" size={16} />
              <small>Fotos</small>
            </span>
            <span>
              <Icon name="layout" size={16} />
              <small>Layout</small>
            </span>
            <span>
              <Icon name="text" size={16} />
              <small>Text</small>
            </span>
            <span>
              <Icon name="background" size={16} />
              <small>Farbe</small>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="ag-mob__copy">
      <p class="ag-kicker" data-reveal>
        {t.mobile_kicker}
      </p>
      <h2 class="ag-h2" data-reveal style="--i:1">
        {t.mobile_title_a} <span class="ag-grad">{t.mobile_title_b}</span>
      </h2>
      <p class="ag-lead" data-reveal style="--i:2">
        {t.mobile_lead}
      </p>
      <ul class="ag-mob__points">
        {points.map((p, i) => (
          <li data-reveal style={`--i:${i + 3}`}>
            <span class="ag-ico">
              <Icon name={p.icon} size={20} />
            </span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Run the loop only while the stage is on screen; scale the 600×420 path layer to the stage width.
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((el) => {
    new IntersectionObserver(([e]) => el.classList.toggle('is-playing', e.isIntersecting), { threshold: 0.25 }).observe(
      el,
    );
    new ResizeObserver(([e]) => el.style.setProperty('--s', (e.contentRect.width / 600).toFixed(4))).observe(el);
  });
</script>

<style is:global>
  .ag-mob__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .ag-mob__copy .ag-lead {
    margin-top: 18px;
  }
  .ag-mob__points {
    display: grid;
    gap: 22px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }
  .ag-mob__points li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: start;
  }
  .ag-mob__points .ag-ico {
    width: 42px;
    height: 42px;
    border-radius: 12px;
  }
  .ag-mob__points h3 {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .ag-mob__points p {
    margin-top: 4px;
    color: var(--ag-muted);
    font-size: 0.9375rem;
  }

  /* Stage: laptop at the back right, phone front left */
  .ag-mob__stage {
    position: relative;
    aspect-ratio: 600 / 460;
  }
  .ag-mob__stage::before {
    content: '';
    position: absolute;
    inset: 15% 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 0, 216, 0.25), rgba(0, 65, 246, 0.18) 60%, transparent);
    filter: blur(30px);
  }
  .ag-mob__laptop {
    position: absolute;
    right: 0;
    top: 6%;
    width: 72%;
  }
  .ag-mob__lscreen {
    position: relative;
    aspect-ratio: 16 / 10;
    padding: 4%;
    border-radius: 14px 14px 4px 4px;
    background: #1b1b22;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5);
  }
  .ag-mob__lbar {
    display: flex;
    gap: 4px;
    height: 8%;
    align-items: center;
  }
  .ag-mob__lbar i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3a3a46;
  }
  .ag-mob__lbody {
    display: grid;
    grid-template-columns: 8% 26% 1fr;
    gap: 3%;
    height: 92%;
    padding-top: 3%;
  }
  .ag-mob__lrail,
  .ag-mob__lpanel {
    border-radius: 6px;
    background: #24242d;
  }
  .ag-mob__lpage {
    display: grid;
    grid-template-rows: 1.1fr 1fr;
    gap: 6%;
    align-self: center;
    justify-self: center;
    width: 62%;
    aspect-ratio: 0.8;
    padding: 5%;
    background: #fff;
    border-radius: 2px;
  }
  .ag-mob__lphoto {
    background: linear-gradient(180deg, #ffb36b, #ff5f8a);
    opacity: 0;
    transition: opacity 0.6s;
  }
  .ag-mob__lgrid {
    background: repeating-linear-gradient(90deg, #d6d6e0 0 10%, transparent 10% 14%) 0 0 / 100% 18%;
  }
  .ag-mob__base {
    height: 10px;
    margin: 0 -6%;
    border-radius: 0 0 14px 14px;
    background: linear-gradient(180deg, #2a2a33, #15151b);
  }
  .ag-mob__toast {
    position: absolute;
    left: 50%;
    bottom: 8%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    color: #17171f;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    translate: -50% 10px;
    opacity: 0;
  }
  .ag-mob__toast svg {
    color: #11a36b;
  }

  .ag-mob__path {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    width: 600px;
    height: 420px;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
    pointer-events: none;
  }
  .ag-mob__arc {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  .ag-mob__arc path {
    stroke-dashoffset: 0;
  }
  .ag-mob__stage.is-playing .ag-mob__arc path {
    animation: ag-dash 1.2s linear infinite;
  }
  @keyframes ag-dash {
    to {
      stroke-dashoffset: -28;
    }
  }
  /* the saved project card travels along the arc */
  .ag-mob__card {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 6px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.95);
    color: #17171f;
    font-size: 11px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    offset-path: path('M232 214 C 290 110, 380 70, 440 140');
    offset-rotate: 0deg;
    offset-distance: 0%;
    opacity: 0;
    white-space: nowrap;
  }
  .ag-mob__card i {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: linear-gradient(160deg, #ffb36b, #ff5f8a);
  }
  .ag-mob__card b {
    display: block;
    font-weight: 600;
  }
  .ag-mob__card small {
    color: #6c6c80;
  }
  .ag-mob__stage.is-playing .ag-mob__card {
    animation: ag-travel 6s var(--ag-ease-io) infinite;
  }
  .ag-mob__stage.is-playing .ag-mob__toast {
    animation: ag-toast 6s var(--ag-ease) infinite;
  }
  .ag-mob__stage.is-playing .ag-mob__lphoto {
    animation: ag-lphoto 6s var(--ag-ease) infinite;
  }
  @keyframes ag-travel {
    0%,
    12% {
      offset-distance: 0%;
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    52% {
      offset-distance: 100%;
      opacity: 1;
    }
    58%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @keyframes ag-toast {
    0%,
    54% {
      opacity: 0;
      translate: -50% 10px;
    }
    60%,
    88% {
      opacity: 1;
      translate: -50% 0;
    }
    96%,
    100% {
      opacity: 0;
      translate: -50% 0;
    }
  }
  @keyframes ag-lphoto {
    0%,
    54% {
      opacity: 0;
    }
    62%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .ag-mob__phone {
    position: absolute;
    left: 6%;
    bottom: 0;
    z-index: 2;
    width: 34%;
    aspect-ratio: 9 / 19;
    padding: 2.4%;
    border-radius: 34px;
    background: #050507;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 40px 80px rgba(0, 0, 0, 0.6),
      inset 0 0 0 2px #24242c;
    animation: ag-bob 7s ease-in-out infinite;
  }
  @keyframes ag-bob {
    50% {
      translate: 0 -10px;
    }
  }
  .ag-mob__screen {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    border-radius: 26px;
    background: #121218;
    overflow: hidden;
    font-size: 10px;
  }
  .ag-mob__pbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 6px;
    padding: 22px 12px 10px;
    color: #e9e9f0;
  }
  .ag-mob__pbar b {
    text-align: center;
    font-weight: 600;
  }
  .ag-mob__pcart {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ag-blue);
  }
  .ag-mob__pcanvas {
    display: grid;
    place-items: center;
    padding: 8px;
    background:
      radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.06) 1px, transparent 0) 0 0 / 12px 12px,
      #0d0d12;
  }
  .ag-mob__ppage {
    width: 92%;
    padding: 7%;
    background: #fff;
    color: #1d1d26;
    border-radius: 2px;
  }
  .ag-mob__pphoto {
    position: relative;
    aspect-ratio: 1.15;
    overflow: hidden;
  }
  .ag-mob__pphoto i {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: ag-swap 9s infinite;
  }
  .ag-mob__pphoto i:nth-child(1) {
    background: linear-gradient(180deg, #ffb36b, #ff5f8a);
    animation-delay: 0s;
  }
  .ag-mob__pphoto i:nth-child(2) {
    background: linear-gradient(180deg, #7fd4ff, #3d7bff);
    animation-delay: 3s;
  }
  .ag-mob__pphoto i:nth-child(3) {
    background: linear-gradient(180deg, #c3f2a0, #4fc7a8);
    animation-delay: 6s;
  }
  .ag-mob__pphoto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 10, 50, 0.55);
    clip-path: polygon(0 78%, 24% 52%, 42% 68%, 64% 44%, 84% 64%, 100% 54%, 100% 100%, 0 100%);
  }
  @keyframes ag-swap {
    0% {
      opacity: 0;
      scale: 1.1;
    }
    6%,
    33% {
      opacity: 1;
      scale: 1;
    }
    40%,
    100% {
      opacity: 0;
    }
  }
  .ag-mob__ppage strong {
    display: block;
    margin: 6px 0 4px;
    font-family: var(--ag-head);
    font-size: 12px;
    font-weight: 600;
  }
  .ag-mob__pdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
  }
  .ag-mob__pdays span {
    height: 5px;
    border-radius: 2px;
    background: #dadae4;
  }
  .ag-mob__pdays .is-on {
    background: var(--ag-magenta);
  }
  .ag-mob__ptools {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 8px 6px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: #8b8b9e;
  }
  .ag-mob__ptools span {
    display: grid;
    justify-items: center;
    gap: 2px;
  }
  .ag-mob__ptools small {
    font-size: 8.5px;
  }
  .ag-mob__ptools .is-on {
    color: var(--ag-blue-l);
  }

  @media (max-width: 960px) {
    .ag-mob__grid {
      grid-template-columns: 1fr;
    }
    .ag-mob__copy {
      order: -1;
    }
    .ag-mob__stage {
      max-width: 600px;
      width: 100%;
      margin-inline: auto;
    }
  }
  @media (max-width: 560px) {
    .ag-mob__phone {
      border-radius: 22px;
      width: 38%;
    }
    .ag-mob__screen {
      border-radius: 17px;
      font-size: 7.5px;
    }
    .ag-mob__pbar {
      padding: 12px 8px 6px;
    }
  }
</style>
