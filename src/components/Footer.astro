---
/** Footer: spectrum hairline, logo + claim, tour links, Jenomics links, legal line. Legal pages live on jenomics.de. */
import Icon from './ui/Icon.astro';
import { pick, fill, type Lang } from '../i18n';
import chrome from '../i18n/chrome.json';
const { lang } = Astro.props as { lang: Lang };
const t = pick(chrome as Record<string, any>, lang);
const nav = t.h_nav as [string, string][];
const company = t.f_links_company as [string, string][];
const ext = (href: string) => href.startsWith('http');
---

<footer class="ag-ft">
  <div class="ag-rainbow" aria-hidden="true"></div>
  <div class="ag-wrap ag-ft__grid">
    <div class="ag-ft__brand">
      <img src="/media/ag-logo-light.webp" alt="Amaze Genius" width="440" height="66" loading="lazy" />
      <p>{t.f_claim}</p>
      <a class="ag-ft__by" href={t.f_jenomics_href} target="_blank" rel="noopener">
        <span>{t.f_by}</span>
        <strong>{t.f_jenomics}</strong>
        <small>{fill(t.f_jenomics_desc)}</small>
      </a>
    </div>
    <nav class="ag-ft__col" aria-label={t.f_col_product}>
      <p class="ag-ft__label">{t.f_col_product}</p>
      <ul>
        {nav.map(([label, href]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="ag-ft__col" aria-label={t.f_col_company}>
      <p class="ag-ft__label">{t.f_col_company}</p>
      <ul>
        {company.map(([label, href]) => (
          <li>
            <a href={href} {...(ext(href) ? { target: '_blank', rel: 'noopener' } : {})}>
              {label}
              {ext(href) && <Icon name="external" size={14} />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="ag-wrap ag-ft__bottom">
    <p>{fill(t.f_copy)}</p>
    <a class="ag-ft__top" href="#start" aria-label={t.f_top}>
      <Icon name="arrow" size={18} />
    </a>
  </div>
</footer>

<style is:global>
  .ag-ft {
    position: relative;
    background: var(--ag-bg);
    color: var(--ag-muted);
    font-size: 0.9375rem;
  }
  .ag-ft__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 48px;
    padding-block: clamp(56px, 7vw, 96px) 48px;
  }
  .ag-ft__brand img {
    width: 200px;
    height: auto;
  }
  .ag-ft__brand > p {
    max-width: 40ch;
    margin-top: 20px;
  }
  .ag-ft__by {
    display: inline-grid;
    grid-template-columns: auto auto;
    column-gap: 6px;
    margin-top: 28px;
    padding: 12px 16px;
    border-radius: var(--ag-r);
    border: 1px solid var(--ag-line);
    text-decoration: none;
    transition:
      border-color var(--ag-fast),
      background-color var(--ag-fast);
  }
  .ag-ft__by:hover {
    border-color: var(--ag-line-2);
    background: rgba(255, 255, 255, 0.03);
  }
  .ag-ft__by strong {
    color: var(--ag-text);
    font-weight: 600;
  }
  .ag-ft__by small {
    grid-column: 1 / -1;
    font-size: 0.8125rem;
    color: var(--ag-dim);
  }
  .ag-ft__label {
    margin-bottom: 14px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ag-dim);
  }
  .ag-ft ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .ag-ft ul a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: color var(--ag-fast);
  }
  .ag-ft ul a:hover {
    color: #fff;
  }
  .ag-ft__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 24px 32px;
    /* divider only as wide as the content, not the gutters */
    background: linear-gradient(var(--ag-line), var(--ag-line)) top center / calc(100% - 2 * var(--ag-gutter)) 1px
      no-repeat;
    font-size: 0.8125rem;
    color: var(--ag-dim);
  }
  .ag-ft__top {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--ag-line-2);
    color: #fff;
    transition:
      background-color var(--ag-fast),
      translate var(--ag-fast) var(--ag-ease);
  }
  .ag-ft__top svg {
    rotate: -90deg;
  }
  .ag-ft__top:hover {
    background: rgba(255, 255, 255, 0.08);
    translate: 0 -3px;
  }
  @media (max-width: 760px) {
    .ag-ft__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ag-ft__brand {
      grid-column: 1 / -1;
    }
  }
</style>
